prefix=${pcfiledir}/@KSSD_ARRAY_PC_PREFIX_RELATIVE@
exec_prefix=${prefix}
libdir=${pcfiledir}/..
includedir=@KSSD_ARRAY_PC_INCLUDEDIR@

Name: KSSD-Array
Description: Segmented permutation-array mapping for encoded DNA k-mers
Version: @KSSD_ARRAY_PACKAGE_VERSION@
Libs: -L${libdir} -lkssd_array
Cflags: -I${includedir}
