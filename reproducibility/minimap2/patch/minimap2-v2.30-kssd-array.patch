diff --git a/kssd_array_minimap2.c b/kssd_array_minimap2.c
new file mode 100644
--- /dev/null
+++ b/kssd_array_minimap2.c
@@ -0,0 +1,50 @@
+#include "kssd_array_minimap2.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+
+mm_kssd_array_t *mm_kssd_array_create(size_t k)
+{
+	mm_kssd_array_t *owner;
+	kssd_array_status_t status;
+
+	owner = (mm_kssd_array_t*)calloc(1, sizeof(*owner));
+	if (owner == 0) {
+		fprintf(stderr, "[ERROR] KSSD-Array context allocation failed\n");
+		return 0;
+	}
+
+	status = kssd_array_init_with_rng(&owner->context,
+	                                  k,
+	                                  KSSD_ARRAY_DEFAULT_SEED,
+	                                  KSSD_ARRAY_RNG_GLIBC_COMPAT);
+	if (status != KSSD_ARRAY_OK) {
+		fprintf(stderr,
+		        "[ERROR] KSSD-Array initialization failed for k=%zu: %s\n",
+		        k,
+		        kssd_array_status_string(status));
+		free(owner);
+		return 0;
+	}
+
+	status = kssd_array_inline_plan_init(&owner->inline_plan,
+	                                     &owner->context);
+	if (status != KSSD_ARRAY_OK) {
+		fprintf(stderr,
+		        "[ERROR] KSSD-Array inline plan initialization failed for k=%zu: %s\n",
+		        k,
+		        kssd_array_status_string(status));
+		kssd_array_destroy(&owner->context);
+		free(owner);
+		return 0;
+	}
+
+	return owner;
+}
+
+void mm_kssd_array_destroy(mm_kssd_array_t *owner)
+{
+	if (owner == 0) return;
+	kssd_array_destroy(&owner->context);
+	free(owner);
+}
